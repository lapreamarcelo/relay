# Required for Docker. APP_URL must be the exact browser-visible origin.
# If RELAY_PORT changes, update APP_URL and every registered OAuth callback too.
APP_URL=http://localhost:3000
RELAY_PORT=3000
POSTGRES_PASSWORD=generate-a-random-value
BETTER_AUTH_SECRET=generate-a-random-value-at-least-32-characters
ALLOW_REGISTRATION=true
RELAY_SETUP_TOKEN=generate-a-private-value-at-least-24-characters

# Required when social-account connections are enabled
ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key

# Only when running without Docker
# DATABASE_URL=postgresql://relay:password@localhost:5432/relay

# Optional tuning; the default is 5
# DATABASE_POOL_SIZE=5

# Required Cloudflare R2 storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=relay-media
R2_REGION=auto
R2_ENDPOINT=
# Optional emergency DNS override for an unreachable R2 edge. Use a trusted Cloudflare IP only.
R2_RESOLVED_IP=
R2_PUBLIC_URL=https://media.example.com

# Optional override for Relay's bundled public GrowthCat client identifier. This is not a server secret.
NEXT_PUBLIC_GROWTHCAT_API_KEY=gc_live_your_relay_key

# Social OAuth applications; add only the providers you use
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# Optional provider/runtime tuning
# META_GRAPH_VERSION=v23.0
# TOKEN_REFRESH_INTERVAL_MS=300000
# PUBLISH_INTERVAL_MS=5000
# ANALYTICS_INTERVAL_MS=60000
# HEALTH_INTERVAL_MS=30000
# REPORT_INTERVAL_MS=3600000
