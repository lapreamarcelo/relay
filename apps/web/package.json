    "better-auth": "^1.6.28",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "playwright": "^1.64.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
