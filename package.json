{
  "name": "relay",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22 <23", "pnpm": "11.19.0" },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "pnpm --filter @relay/web start",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @relay/web test:e2e",
    "db:migrate": "pnpm --filter @relay/database db:migrate",
    "relay": "node apps/cli/src/relay.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
